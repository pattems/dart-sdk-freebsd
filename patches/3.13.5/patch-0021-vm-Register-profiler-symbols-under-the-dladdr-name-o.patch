From a4bc41ec77fbf5e55d0d09886eee8c66c3b60d37 Mon Sep 17 00:00:00 2001
From: Pattems <patrick@crandol.com>
Date: Mon, 5 Oct 2026 21:29:13 -0400
Subject: [PATCH 21/25] [vm] Register profiler symbols under the dladdr() name
 on FreeBSD

The native symbol resolver matches symbol tables by the file name that
dladdr() reports. The embedder registers the executable's .sym table
under argv[0], which matches glibc, but FreeBSD reports the resolved path
of the main executable. Native frames in crash backtraces were therefore
not symbolized. Register the table under the name dladdr() reports.
---
 runtime/bin/exe_utils.cc | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/runtime/bin/exe_utils.cc b/runtime/bin/exe_utils.cc
index a5e24329..99f237b8 100644
--- a/runtime/bin/exe_utils.cc
+++ b/runtime/bin/exe_utils.cc
@@ -4,6 +4,10 @@
 
 #include "bin/exe_utils.h"
 
+#if defined(__FreeBSD__)
+#include <dlfcn.h>
+#endif
+
 #include "bin/directory.h"
 #include "bin/file.h"
 #include "bin/platform.h"
@@ -141,7 +145,19 @@ void EXEUtils::LoadDartProfilerSymbols(const char* argv0) {
 
   int64_t size = file->Length();
   MappedMemory* mapping = file->Map(File::kReadOnly, 0, size);
-  Dart_AddSymbols(argv0, mapping->address(), size);
+  const char* dso_name = argv0;
+#if defined(__FreeBSD__)
+  // The symbols are looked up by the name dladdr() reports for the
+  // executable. That is argv[0] with glibc, but FreeBSD reports the resolved
+  // path, so register them under that name.
+  Dl_info info;
+  if (dladdr(reinterpret_cast<void*>(&EXEUtils::LoadDartProfilerSymbols),
+             &info) != 0 &&
+      info.dli_fname != nullptr) {
+    dso_name = info.dli_fname;
+  }
+#endif
+  Dart_AddSymbols(dso_name, mapping->address(), size);
   mapping->Leak();  // Let us delete the object but keep the mapping.
   delete mapping;
   file->Release();
