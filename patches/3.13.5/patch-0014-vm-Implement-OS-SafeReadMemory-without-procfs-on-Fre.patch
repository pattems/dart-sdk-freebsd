From 52dab4d465b94694c039130d6484d594627f366d Mon Sep 17 00:00:00 2001
From: Pattems <patrick@crandol.com>
Date: Tue, 6 Oct 2026 23:39:04 -0400
Subject: [PATCH 14/25] [vm] Implement OS::SafeReadMemory() without procfs on
 FreeBSD

OS::SafeReadMemory() reads through /proc/self/mem so that reading an
unmapped address fails instead of crashing. FreeBSD does not mount
procfs by default. Its write(2) fails with EFAULT rather than faulting
when the source is not readable, so copy the memory through a pipe
instead.

Service_ReadNativeMemory_InvalidAddress expects the EFAULT
message ("Bad address") on FreeBSD instead of EIO's.
---
 runtime/vm/os_linux.cc     | 33 +++++++++++++++++++++++++++++++++
 runtime/vm/service_test.cc |  5 ++++-
 2 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/runtime/vm/os_linux.cc b/runtime/vm/os_linux.cc
index 14cdc119..671bbd14 100644
--- a/runtime/vm/os_linux.cc
+++ b/runtime/vm/os_linux.cc
@@ -588,6 +588,38 @@ bool OS::SafeReadMemory(void* address,
                         size_t size_in_bytes,
                         const char** error) {
   ThreadSignalBlocker tsb(SIGPROF);
+#if defined(__FreeBSD__)
+  // There is no /proc/self/mem without procfs. write(2) fails with EFAULT
+  // instead of faulting when the source is not readable, so copy the memory
+  // through a pipe.
+  int fds[2];
+  if (pipe2(fds, O_CLOEXEC) != 0) {
+    *error = strerror(errno);
+    return false;
+  }
+  const size_t kChunkSize = 4 * KB;
+  const uint8_t* source = reinterpret_cast<const uint8_t*>(address);
+  size_t copied = 0;
+  while (copied < size_in_bytes) {
+    const size_t chunk = Utils::Minimum(size_in_bytes - copied, kChunkSize);
+    const ssize_t written = TEMP_FAILURE_RETRY_NO_SIGNAL_BLOCKER(
+        write(fds[1], source + copied, chunk));
+    if (written <= 0) {
+      *error = strerror(errno);
+      break;
+    }
+    const ssize_t read_back = TEMP_FAILURE_RETRY_NO_SIGNAL_BLOCKER(
+        read(fds[0], buffer + copied, written));
+    if (read_back != written) {
+      *error = strerror(errno);
+      break;
+    }
+    copied += read_back;
+  }
+  close(fds[0]);
+  close(fds[1]);
+  return copied == size_in_bytes;
+#else
   int fd = TEMP_FAILURE_RETRY_NO_SIGNAL_BLOCKER(
       open("/proc/self/mem", O_RDONLY | O_CLOEXEC));
   if (fd < 0) {
@@ -601,6 +633,7 @@ bool OS::SafeReadMemory(void* address,
   }
   close(fd);
   return bytes_read == static_cast<ssize_t>(size_in_bytes);
+#endif  // defined(__FreeBSD__)
 }
 
 void OS::Sleep(int64_t millis) {
diff --git a/runtime/vm/service_test.cc b/runtime/vm/service_test.cc
index 198cca69..2019cb14 100644
--- a/runtime/vm/service_test.cc
+++ b/runtime/vm/service_test.cc
@@ -820,7 +820,10 @@ ISOLATE_UNIT_TEST_CASE(Service_ReadNativeMemory_InvalidAddress) {
   EXPECT_EQ(MessageHandler::kOK, handler.HandleNextMessage());
 
   EXPECT_SUBSTRING("\"code\":1004", handler.msg());
-#if defined(DART_HOST_OS_LINUX) || defined(DART_HOST_OS_ANDROID)
+#if defined(__FreeBSD__)
+  // Without /proc/self/mem, the read fails with EFAULT rather than EIO.
+  EXPECT_SUBSTRING("Bad address", handler.msg());
+#elif defined(DART_HOST_OS_LINUX) || defined(DART_HOST_OS_ANDROID)
   EXPECT_SUBSTRING("Input\\/output error", handler.msg());
 #elif defined(DART_HOST_OS_WINDOWS)
   EXPECT_SUBSTRING("error 299", handler.msg());
