 runtime/bin/file_linux.cc             |  1 +
 runtime/bin/namespace_linux.cc        |  1 +
 runtime/bin/process_linux.cc          |  1 +
 runtime/bin/socket_base_linux.cc      |  1 +
 runtime/platform/largefile.h          | 27 +++++++++++++++++++++++++++
 runtime/platform/platform_sources.gni |  1 +
 runtime/vm/os_linux.cc                |  1 +
 8 files changed, 34 insertions(+)
 create mode 100644 runtime/platform/largefile.h

diff --git a/runtime/bin/directory_linux.cc b/runtime/bin/directory_linux.cc
index 6d9df40a..529261f0 100644
--- a/runtime/bin/directory_linux.cc
+++ b/runtime/bin/directory_linux.cc
@@ -22,6 +22,7 @@
 #include "bin/file.h"
 #include "bin/namespace.h"
 #include "bin/platform.h"
+#include "platform/largefile.h"
 #include "platform/signal_blocker.h"
 
 namespace dart {
diff --git a/runtime/bin/file_linux.cc b/runtime/bin/file_linux.cc
index 04bb047b..4d6de71a 100644
--- a/runtime/bin/file_linux.cc
+++ b/runtime/bin/file_linux.cc
@@ -20,6 +20,7 @@
