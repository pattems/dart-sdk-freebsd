From 8603f06dd13e851660a416067cee2b2f029faa62 Mon Sep 17 00:00:00 2001
From: Pattems <patrick@crandol.com>
Date: Mon, 5 Oct 2026 20:30:30 -0400
Subject: [PATCH 02/25] [io] Treat any nonzero boolean socket option value as
 enabled

getsockopt() only guarantees a nonzero value for an enabled boolean
option. macOS and FreeBSD return the option's flag bit instead of 1
(e.g. 0x20 for SO_BROADCAST, 0x4 for TCP_NODELAY on macOS), so
RawDatagramSocket.broadcastEnabled and the tcpNoDelay option read back
as false after enabling them. Check for != 0 in GetNoDelay,
GetMulticastLoop and GetBroadcast.

Fixes https://github.com/dart-lang/sdk/issues/50171
---
 runtime/bin/socket_base_posix.cc | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/runtime/bin/socket_base_posix.cc b/runtime/bin/socket_base_posix.cc
index 0d6fa6db..92aadd1a 100644
--- a/runtime/bin/socket_base_posix.cc
+++ b/runtime/bin/socket_base_posix.cc
@@ -423,7 +423,7 @@ bool SocketBase::GetNoDelay(intptr_t fd, bool* enabled) {
   int err = NO_RETRY_EXPECTED(getsockopt(fd, IPPROTO_TCP, TCP_NODELAY,
                                          reinterpret_cast<void*>(&on), &len));
   if (err == 0) {
-    *enabled = (on == 1);
+    *enabled = (on != 0);
   }
   return (err == 0);
 }
@@ -445,7 +445,7 @@ bool SocketBase::GetMulticastLoop(intptr_t fd,
                                                      : IPV6_MULTICAST_LOOP;
   if (NO_RETRY_EXPECTED(getsockopt(fd, level, optname,
                                    reinterpret_cast<char*>(&on), &len)) == 0) {
-    *enabled = (on == 1);
+    *enabled = (on != 0);
     return true;
   }
   return false;
@@ -480,7 +480,7 @@ bool SocketBase::GetBroadcast(intptr_t fd, bool* enabled) {
   int err = NO_RETRY_EXPECTED(getsockopt(fd, SOL_SOCKET, SO_BROADCAST,
                                          reinterpret_cast<char*>(&on), &len));
   if (err == 0) {
-    *enabled = (on == 1);
+    *enabled = (on != 0);
   }
   return (err == 0);
 }
