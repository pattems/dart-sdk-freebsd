From fd032953e8fae7266c1996a1bf027aac212a1bb2 Mon Sep 17 00:00:00 2001
From: Pattems <patrick@crandol.com>
Date: Wed, 7 Oct 2026 18:13:57 -0400
Subject: [PATCH 25/25] [vm] Don't run SweepDontNeed on FreeBSD

The test checks that RSS drops by more than 50 MB right after the
sweeper releases free pages with madvise(MADV_DONTNEED). FreeBSD keeps
such pages resident until there is memory pressure, so RSS doesn't drop
at once. The pages are still released: under memory pressure FreeBSD
reclaims them like Linux does. The test was already Linux-only.

TEST=vm/cc/SweepDontNeed
---
 runtime/vm/heap/heap_test.cc | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/runtime/vm/heap/heap_test.cc b/runtime/vm/heap/heap_test.cc
index ee40eb6e..69524c10 100644
--- a/runtime/vm/heap/heap_test.cc
+++ b/runtime/vm/heap/heap_test.cc
@@ -1186,7 +1186,9 @@ ISOLATE_UNIT_TEST_CASE(FinalizerEntry_Generations) {
   FinalizerEntry_Generations(kOld, kImm, false, false, false);
 }
 
-#if !defined(PRODUCT) && defined(DART_HOST_OS_LINUX)
+// FreeBSD keeps MADV_DONTNEED pages resident until there is memory
+// pressure, so RSS doesn't drop right after the sweep.
+#if !defined(PRODUCT) && defined(DART_HOST_OS_LINUX) && !defined(__FreeBSD__)
 ISOLATE_UNIT_TEST_CASE(SweepDontNeed) {
   auto gc_with_fragmentation = [&] {
     HANDLESCOPE(thread);
-- 
2.54.0

