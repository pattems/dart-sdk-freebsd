From 2563d306e595d1ad371e2a0547bd5fdf19756c0f Mon Sep 17 00:00:00 2001
From: Pattems <patrick@crandol.com>
Date: Mon, 5 Oct 2026 21:06:51 -0400
Subject: [PATCH 22/25] [pkg/mmap] Use the FreeBSD value of MAP_ANONYMOUS on
 FreeBSD

package:mmap hard-codes the Linux value of MAP_ANONYMOUS (0x20). The VM
treats FreeBSD as a Linux variant, but there MAP_ANON is 0x1000, so the
anonymous mapping for the finalizer stub failed and the heap snapshot
tool crashed while loading a snapshot.
---
 pkg/mmap/lib/src/mmap_impl.dart | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/pkg/mmap/lib/src/mmap_impl.dart b/pkg/mmap/lib/src/mmap_impl.dart
index 05706613..0568ca58 100644
--- a/pkg/mmap/lib/src/mmap_impl.dart
+++ b/pkg/mmap/lib/src/mmap_impl.dart
@@ -7,6 +7,7 @@
 // ignore_for_file: non_constant_identifier_names
 
 import 'dart:ffi';
+import 'dart:io';
 import 'dart:typed_data';
 
 import 'package:ffi/ffi.dart';
@@ -74,7 +75,9 @@ const int kProtRead = 1;
 const int kProtWrite = 2;
 const int kProtExec = 4;
 const int kMapPrivate = 2;
-const int kMapAnon = 0x20;
+// FreeBSD, which the VM treats as a Linux variant, uses a different value.
+final int kMapAnon =
+    Platform.operatingSystemVersion.startsWith('FreeBSD') ? 0x1000 : 0x20;
 const int kMapFailed = -1;
 
 //  #include <cstddef>
-- 
